# DocuPulse Environment Configuration

# Canonical Production URL (used for Sitemap, Robots, and OpenGraph)
NEXT_PUBLIC_SITE_URL=https://docupulse.com

# Google AdSense Publisher ID (e.g. ca-pub-1234567890123456)
# When set, live AdSense ads will be requested. When unset, development placeholders are rendered.
NEXT_PUBLIC_ADSENSE_CLIENT=

# Google Analytics Measurement ID (Optional)
NEXT_PUBLIC_GA_ID=
