# PDFToolkit Environment Configuration

# Canonical Production URL (used for Sitemap, Robots, and OpenGraph)
NEXT_PUBLIC_SITE_URL=https://pdftoolkit.theaethersync.com

# Google AdSense Publisher ID. Defaults to the production account in code;
# set this only to override for a staging/preview deployment.
